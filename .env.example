NODE_ENV=production
PORT=

# Timezone for all calendar-day business logic (cake lead times, baker daily
# caps, partner days off). Docker/PM2 configs set this too; keep it here for
# bare `node index.js` runs. Do NOT leave the server on UTC.
TZ=Asia/Kolkata

MONGO_URI=
JWT_SECRET=replace_with_secure_jwt_secret

# Encryption-at-rest key for sensitive DB fields (partner bank account number,
# IFSC). Any strong passphrase or 64-hex-char string; the 32-byte AES-256-GCM
# key is derived from it. If unset, those fields are stored in PLAINTEXT (a
# warning is logged) — set it in production. Rotating requires re-encrypting
# existing rows.
FIELD_ENCRYPTION_KEY=replace_with_strong_random_secret

PUBLIC_BASE_URL=
# Comma-separated list of allowed frontend origins.
# Add your Netlify URL here once deployed, e.g.:
#   CORS_ALLOWED_ORIGINS=https://quickqare-admin.netlify.app,https://app.quickqare.com
# Localhost origins are always allowed automatically.
CORS_ALLOWED_ORIGINS=

# ---- Image uploads --------------------------------------------------------
# Backend selection:
#   USE_LOCAL_UPLOADS=true      -> local disk (<backend>/uploads), dev/self-host
#   (leave both unset/false)    -> Cloudflare R2 (default)
# NOTE: the Cloudinary backend was removed (unpatched high-severity advisories).
# Leave UPLOAD_BACKEND unset; a stray UPLOAD_BACKEND=cloudinary now warns and
# falls back to R2.
USE_LOCAL_UPLOADS=false
UPLOAD_BACKEND=

# Cloudflare R2 (default backend; also used for partner KYC/selfies).
# R2_PUBLIC_URL must be the bucket's PUBLIC domain (r2.dev public URL or a
# connected custom domain) — uploaded images are served from here.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Set to "eu" only for EU-jurisdiction buckets; otherwise leave blank.
R2_JURISDICTION=

# Private serving for SENSITIVE uploads (partner selfies / KYC identity docs).
# When "true", those files are handed to admins/partners as short-lived signed
# URLs instead of public links. For this to actually protect the files, the
# bucket (or the selfies/ + kyc/ prefixes) MUST be private — i.e. NOT reachable
# at the public r2.dev/custom domain. Leave "false" (default) until that private
# bucket is set up; the app behaves exactly as before with it off.
R2_PRIVATE_UPLOADS=false
R2_SIGNED_URL_TTL_SECONDS=900

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use literal \n inside the value (do not paste real newlines)
FIREBASE_PRIVATE_KEY=



GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

ADMIN_JWT_ACCESS_SECRET=replace_with_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=replace_with_admin_refresh_secret
ADMIN_ACCESS_TTL_SECONDS=900
ADMIN_REFRESH_TTL_SECONDS=604800
ADMIN_2FA_CHALLENGE_TTL_SECONDS=300
ADMIN_2FA_TEST_CODE=123456

USER_JWT_TTL=90d
PARTNER_JWT_TTL=90d

MSG91_AUTH_KEY=your_msg91_server_auth_key
MSG91_SKIP_ACCESS_TOKEN_VERIFY=false
MSG91_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91

# Binds the MSG91 access token to the phone being claimed at /api/auth/msg91/exchange.
# Leave unset (= "strict"). Without binding, an attacker can OTP their own number
# and exchange that valid token for a session on ANY phone.
#   strict  - reject on mismatch AND when no phone can be recovered (fail closed)
#   enforce - reject on mismatch, allow when no phone can be recovered (FAIL OPEN —
#             leaves the takeover exploitable; temporary incident mitigation only)
#   off     - skip the check entirely (emergency kill-switch)
MSG91_PHONE_BINDING=strict

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_NAME=QuickQare Admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_admin_password
ADMIN_BOOTSTRAP_ROLE=SuperAdmin
